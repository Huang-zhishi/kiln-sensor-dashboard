# 窑炉传感器中控台 - 环境变量示例
# 复制为 .env 并按实际环境填写（.env 已被 .gitignore 排除）

# ---- TDengine 连接（中控台直连读取时序数据） ----
TDENGINE_HOST=192.168.1.78
TDENGINE_PORT=6041
TDENGINE_USER=dashboard
TDENGINE_PASSWORD=changeme
TDENGINE_DATABASE=test

# ---- 统计卡片开关（1=开启 24h 聚合查询） ----
ENABLE_STATS=1

# ---- API 访问令牌（可选）----
# 设置后所有 /api/* 请求需携带 x-api-token 或 Authorization: Bearer
# API_ACCESS_TOKEN=

# ---- Agent 对话入口（异常详情「问 Agent」按钮）----
# 留空则按钮隐藏；配置后指向 Agent 前端地址
# AGENT_CHAT_URL=http://192.168.1.78:5000/
