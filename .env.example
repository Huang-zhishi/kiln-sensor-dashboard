# 窑炉传感器中控台 - 环境变量示例
# 复制为 .env 并按实际环境填写（.env 已被 .gitignore 排除）

# ---- TDengine 连接（中控台直连读取时序数据） ----
TDENGINE_HOST=192.168.1.78
TDENGINE_PORT=6041
TDENGINE_USER=dashboard
TDENGINE_PASSWORD=changeme
TDENGINE_DATABASE=test

# ---- 统计卡片开关（1=开启 24h 聚合查询） ----
ENABLE_STATS=1

# ---- API 访问令牌（可选）----
# 设置后所有 /api/* 请求需携带 x-api-token 或 Authorization: Bearer
# API_ACCESS_TOKEN=

# ---- 未处理超时升级提醒（分钟；留空用默认 P1=60 / P2=240 / P3=1440）----
# ESCALATION_P1_MINUTES=60
# ESCALATION_P2_MINUTES=240
# ESCALATION_P3_MINUTES=1440
# 同一事件重复提醒间隔（小时）
# ESCALATION_RE_NOTIFY_HOURS=6

# ---- 异常闭环周报自动推送（容器时区 Asia/Shanghai）----
# WEEKLY_REPORT_ENABLED=1
# WEEKLY_REPORT_DOW=1     # 1=周一 … 7=周日
# WEEKLY_REPORT_HOUR=8    # 0-23

# ---- Agent 对话入口（异常详情「问 Agent」按钮）----
# 留空则按钮隐藏；配置后指向 Agent 前端地址
# AGENT_CHAT_URL=http://192.168.1.78:5000/

# ---- Agent 增强（可选：周报 AI 点评）----
# 配置后周报会调用 Agent /api/v1/chat 生成一段管理建议；未配置或失败则跳过
# AGENT_BASE_URL=http://192.168.1.78:5000
# AGENT_API_TOKEN=<Agent 的 API_AUTH_TOKEN>
