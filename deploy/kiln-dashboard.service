# /etc/systemd/system/kiln-dashboard.service
# 部署：cp deploy/kiln-dashboard.service /etc/systemd/system/
#       systemctl daemon-reload && systemctl enable --now kiln-dashboard
# 日志：journalctl -u kiln-dashboard -f

[Unit]
Description=Kiln Sensor Dashboard (Next.js standalone)
After=network.target

[Service]
Type=simple
# 按实际部署路径修改
WorkingDirectory=/opt/kiln-dashboard
ExecStart=/usr/bin/node .next/standalone/server.js
Environment=NODE_ENV=production
Environment=PORT=3000
# TDengine 凭据从 .env 读取；standalone 运行时不自动加载 .env，
# 此处直接注入（或在 ExecStart 前用 dotenv 预载）：
#EnvironmentFile=/opt/kiln-dashboard/.env
Restart=always
RestartSec=3
# 时序库写入 + SSE 长连接，正常远低于此值，仅作兜底
MemoryMax=4G

[Install]
WantedBy=multi-user.target
